# Copia este archivo como .env y ajusta los valores (NO subas .env a GitHub)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/sistep
MODEL_PATH=models/modelo_rf.pkl
# "random_forest" (carga el .pkl) o "mock" (reglas simuladas, sin sklearn)
MODEL_BACKEND=random_forest
# Orígenes permitidos por CORS si el frontend corre en otro puerto (p. ej. Live Server)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Opcional: carpeta del frontend (por defecto ../frontend, servida en http://localhost:3000)
# FRONTEND_DIR=../frontend

# --- Autenticación ---
# Obligatorio en producción: cadena larga y aleatoria (no uses el valor de ejemplo).
AUTH_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria
# Duración de la sesión en minutos (480 = 8 horas).
AUTH_TOKEN_MINUTOS=480
# Bloqueo temporal tras varios intentos fallidos por IP + usuario.
AUTH_MAX_INTENTOS=5
AUTH_BLOQUEO_MINUTOS=5
# Usuarios demo (admin, acastro, cmendez). Pon 0 en producción.
AUTH_SEED_DEMO=1
AUTH_DEMO_PASSWORD=Sistep2026!
